model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  inviteCode String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships     OrganizationMembership[]
  voiceProviders  OrganizationVoiceProvider[]
  sessions        Session[]
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  orgRole        OrgRole          @default(member)
  status         MembershipStatus @default(pending)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model VoiceProvider {
  id                String            @id @default(cuid())
  name              String
  type              VoiceProviderType @default(deepl)
  apiUrl            String
  apiKeyCiphertext  String            @db.Text
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organizations OrganizationVoiceProvider[]
}

model OrganizationVoiceProvider {
  id              String  @id @default(cuid())
  organizationId  String
  voiceProviderId String
  enabled         Boolean @default(true)
  isDefault       Boolean @default(false)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceProvider VoiceProvider @relation(fields: [voiceProviderId], references: [id], onDelete: Cascade)

  @@unique([organizationId, voiceProviderId])
  @@index([organizationId])
}

model Session {
  id             String        @id @default(cuid())
  sessionId      String        @unique
  status         SessionStatus @default(pending)
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  organizationId String?

  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  participants       Participant[]
  transcriptSegments TranscriptSegment[]
  audioRecordings    AudioRecording[]

  @@index([organizationId])
}

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  passwordHash      String
  displayName       String
  defaultSourceLang String      @default("en")
  defaultTargetLang String      @default("es")
  globalRole        GlobalRole?
  createdAt         DateTime    @default(now())

  participants Participant[]
  memberships  OrganizationMembership[]
}

model Participant {
  id            String    @id @default(cuid())
  sessionId     String
  userId        String
  clientId      String
  sourceLang    String
  targetLang    String
  isInitiator   Boolean   @default(false)
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?
  accountUserId String?

  session            Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  accountUser        User?               @relation(fields: [accountUserId], references: [id], onDelete: SetNull)
  transcriptSegments TranscriptSegment[]
  audioRecordings    AudioRecording[]

  @@index([sessionId])
  @@index([userId])
  @@index([accountUserId])
}

model TranscriptSegment {
  id            String         @id @default(cuid())
  sessionId     String
  participantId String?
  role          TranscriptRole
  language      String
  text          String         @db.Text
  isFinal       Boolean        @default(true)
  sequence      Int
  recordedAt    DateTime       @default(now())

  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([sessionId, recordedAt])
}

